{
  "realm": "arkhe",
  "enabled": true,
  "displayName": "arkhe",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginTheme": "keycloak",
  "clients": [
    {
      "clientId": "arkhe-admin",
      "name": "arkhe 管理画面",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "arkhe-admin-secret-for-demo-only",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8057/admin/callback",
        "http://127.0.0.1:8057/admin/callback",
        "http://arkhe.localhost:8057/admin/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "nibb-invenio",
      "name": "基礎生物学研究所の InvenioRDM",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "nibb-invenio-secret-for-demo-only",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "arkhe-api",
        "ark:mint",
        "ark:update",
        "roles",
        "profile",
        "email"
      ]
    }
  ],
  "users": [
    {
      "username": "ops",
      "enabled": true,
      "emailVerified": true,
      "email": "ops@example.ac.jp",
      "firstName": "運用者",
      "lastName": "システム",
      "credentials": [
        {
          "type": "password",
          "value": "arkhe-demo-2026",
          "temporary": false
        }
      ]
    },
    {
      "username": "naan-admin",
      "enabled": true,
      "emailVerified": true,
      "email": "naan-admin@example.ac.jp",
      "firstName": "NAAN",
      "lastName": "管理者",
      "credentials": [
        {
          "type": "password",
          "value": "arkhe-demo-2026",
          "temporary": false
        }
      ]
    },
    {
      "username": "nibb",
      "enabled": true,
      "emailVerified": true,
      "email": "nibb@example.ac.jp",
      "firstName": "基礎生物",
      "lastName": "研究所",
      "credentials": [
        {
          "type": "password",
          "value": "arkhe-demo-2026",
          "temporary": false
        }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "arkhe-api",
      "description": "arkhe の API を叩くための audience",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "aud-arkhe-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "arkhe-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "ark:mint",
      "description": "ARK を採番する",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "ARK を採番する"
      }
    },
    {
      "name": "ark:update",
      "description": "既存 ARK を更新する",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "既存 ARK を更新する"
      }
    },
    {
      "name": "ark:read",
      "description": "ARK を読む",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "ARK を読む"
      }
    },
    {
      "name": "ark:tombstone",
      "description": "対象が失われたと宣言する",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "対象が失われたと宣言する"
      }
    }
  ],
  "defaultDefaultClientScopes": [
    "arkhe-api"
  ]
}
