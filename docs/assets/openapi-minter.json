          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "oauth2": [
              "ark:update"
            ]
          },
          {
            "bearer": []
          }
        ]
      },
      "patch": {
        "tags": [
          "ark"
        ],
        "summary": "Patch",
        "description": "**Update the fields you send, and leave the rest alone.** Requires `ark:update`.\n\n`PUT` replaces the record: every field you omit takes its default, so repointing an ARK\nwith `{\"ark\": …, \"url\": …}` alone **empties its title, its who and its when**. That is\ncorrect for a replacement and wrong for what people actually do most of the time, which\nis move an object.\n\nSending a field as `\"\"` clears it; not sending it leaves it untouched. Both are needed,\nwhich is why this is not simply \"ignore empty strings\".",
        "operationId": "patch_api_update_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArkOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "oauth2": [
              "ark:update"
            ]
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/update/bulk": {
      "put": {
        "tags": [
          "ark"
        ],
        "summary": "Bulk Update",
        "description": "Update in bulk. Rows are matched by key, and **nothing is applied unless every row\nis found and in reach** — there is no partial application.",
        "operationId": "bulk_update_api_update_bulk_put",
        "requestBody": {
          "content": {
