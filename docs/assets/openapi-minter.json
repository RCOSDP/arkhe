  "tags": [
    {
      "name": "ark",
      "description": "Minting and updating. **A write never reaches outside the caller's registered reach.**"
    },
    {
      "name": "resolve",
      "description": "Resolution, with the `?` (a brief description), `??` (the persistence statement), `?info` (for a person) and `?json` (for a program) inflections. **A description can be answered even when the object cannot be reached** (FAIR A2). Present only when started with `ARKHE_RESOLVER=1`."
    }
